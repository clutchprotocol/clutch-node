# Docker ignore file to optimize build context and security

# Git files
.git
.github
.gitignore

# Documentation
*.md
docs/
examples/

# Development files
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts — exclude the whole dir; nothing under target/ is ever COPY'd.
# Listing subdirs left target/release/ inside the context, so a local
# `cargo build --release` shipped GBs to the daemon on every docker build.
/target
*.pdb

# RocksDB / sweep leftovers from local runs and tests
*.db/
sweep.timestamp

# Test and output files
output/
tests/
*.log

# OS specific files
.DS_Store
Thumbs.db
*.tmp

# Docker files (avoid recursion)
Dockerfile*
.dockerignore
docker-compose*.yml

# CI/CD files
.github/workflows/

# Scripts (except essential ones)
scripts/

# Environment and config files with secrets
.env
.env.local
*.key
*.pem

# Dependencies and cache
node_modules/
npm-debug.log*

# Runtime data
*.pid
package-lock.json
yarn.lock
npm-shrinkwrap.json
*.sqlite

# Allow Cargo.lock (needed for reproducible Rust builds)
!Cargo.lock

# Coverage and test reports
coverage/
*.lcov